# Sona AI OS - Nginx Reverse Proxy Dockerfile

FROM nginx:alpine

# Create non-root user
RUN addgroup -g 1000 sona && \
    adduser -u 1000 -G sona -D -s /bin/sh sona

# Copy nginx configuration
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf

# Fix permissions for non-root operation
RUN chown -R sona:sona /var/cache/nginx && \
    chown -R sona:sona /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R sona:sona /var/run/nginx.pid

USER sona

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
